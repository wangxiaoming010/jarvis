{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsique.local/contracts/ui/0.1/spec.schema.json",
  "title": "Opsique UI 0.1 json-render-compatible profile",
  "type": "object",
  "required": ["root", "elements"],
  "additionalProperties": false,
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1
    },
    "elements": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": {
        "$ref": "#/$defs/element"
      }
    }
  },
  "$defs": {
    "element": {
      "type": "object",
      "required": ["type", "props", "children"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "Card",
            "Stack",
            "Grid",
            "ActionGroup",
            "Form",
            "Text",
            "Metric",
            "Badge",
            "Button",
            "TextField",
            "Select",
            "Chart",
            "Table",
            "TextArea",
            "Steps",
            "Flowchart",
            "Slider",
            "Switch",
            "Radio",
            "Checkbox",
            "Heading",
            "Divider",
            "Spacer",
            "Progress",
            "Rating",
            "Callout",
            "TagList",
            "List",
            "CodeBlock",
            "Accordion",
            "Tabs",
            "Timeline",
            "Row",
            "GaugeChart",
            "RadarChart",
            "FunnelChart",
            "Heatmap",
            "CandlestickChart",
            "NumericScatterChart",
            "RadialChart",
            "MetricGrid",
            "KPIGrid",
            "ComparisonList",
            "MeterList",
            "Image",
            "RecordCard",
            "Icon",
            "NumberField",
            "DatePicker",
            "TimeField",
            "DateRangePicker",
            "CheckboxGroup",
            "ComboBox",
            "ToggleGroup",
            "Map",
            "ProductCard",
            "ItemCard",
            "ItemCardGroup",
            "Dashboard",
            "SwitchGroup",
            "Followup",
            "SunburstChart",
            "SankeyChart",
            "GeneratedComposition",
            "ProductSignals",
            "ListBlock",
            "Diagram",
            "ComposedChart"
          ]
        },
        "props": {
          "type": "object"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "slots": {
          "type": "object",
          "propertyNames": {
            "not": {
              "const": "default"
            }
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "visible": {
          "$ref": "#/$defs/condition"
        },
        "on": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["action", "params"],
            "properties": {
              "action": {
                "enum": ["dispatch", "submitForm", "setState"]
              },
              "params": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "repeat": {
          "type": "object",
          "required": ["statePath", "key"],
          "properties": {
            "statePath": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "$and": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            },
            "$or": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "$state": {
              "type": "string"
            },
            "$item": {
              "type": "string"
            },
            "$index": {
              "const": true
            },
            "eq": {
              "type": ["string", "number", "boolean", "null"]
            },
            "neq": {
              "type": ["string", "number", "boolean", "null"]
            },
            "not": {
              "const": true
            }
          },
          "oneOf": [
            {
              "required": ["$state"]
            },
            {
              "required": ["$item"]
            },
            {
              "required": ["$index"]
            }
          ],
          "not": {
            "required": ["eq", "neq"]
          }
        }
      ]
    }
  }
}
