{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "context", "componentId", "instanceId", "event", "action", "params"],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "componentId": {
      "type": "string",
      "minLength": 1
    },
    "instanceId": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "required": ["threadId", "viewId", "revision"],
      "additionalProperties": false,
      "properties": {
        "threadId": {
          "type": "string"
        },
        "viewId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "action": {
      "enum": ["dispatch", "submitForm"]
    },
    "params": {
      "type": "object",
      "required": ["actionId"],
      "properties": {
        "actionId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
