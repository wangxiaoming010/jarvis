# Copy to .env. The development server creates a random token at .data/client-token.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=.data/openbot.sqlite
# Optional fixed owner token (at least 24 characters); defaults to a random local token.
# The service only supports local use; never expose it publicly.
# OPENBOT_TOKEN=
# Optional development preview address; the desktop application connects automatically.
VITE_SERVER_URL=http://127.0.0.1:4310
# CLIENT_PORT=1420

# Bot 对话模型：每个 Bot 独立处理消息、记忆和调度，共用服务端连接配置。
# 群消息投递给各成员自行判断；Worker 使用本机 Codex / Claude Code。
# 密钥不要使用 VITE_ 前缀，也不要填入前端代码或提交到 Git。
BRAIN_PROVIDER=deepseek
BRAIN_BASE_URL=https://api.deepseek.com
BRAIN_MODEL=deepseek-flash
# 普通群消息的独立注意力判断；留空跟随对话模型，私聊和直接提及不调用。
ATTENTION_MODEL=
# Bot 主会话总上下文预算（估算 token，含工具定义和回答预留）；按模型实际容量调整。
# OPENBOT_CONTEXT_TOKENS=65536
BRAIN_ENABLED=true
# 可统一使用 BRAIN_API_KEY，或填写当前服务对应的密钥变量。
# BRAIN_API_KEY=
DEEPSEEK_API_KEY=

# 本地 Bridge（启动器默认自动启动；独立令牌保存于 .data/bridge-token）
OPENBOT_BRIDGE_AUTOSTART=true
OPENBOT_MAX_ROUNDS=6
OPENBOT_WORKERS_PER_BOT=2
OPENBOT_WORKERS_PER_DEVICE=4
# OPENBOT_CODEX_PATH=/absolute/path/to/codex
# OPENBOT_CLAUDE_PATH=/absolute/path/to/claude
# OPENBOT_BRIDGE_TOKEN=
# 可选总时长限制（毫秒）；默认 0，不因固定时长自动中断工作。
# OPENBOT_TASK_TIMEOUT_MS=0
