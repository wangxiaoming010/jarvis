{
  "name": "jarvis-workbench",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx server/main.ts",
    "build": "tsc --noEmit && vite build && npm run notices",
    "start": "tsx server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "notices": "node scripts/notices.mjs",
    "release:check": "node scripts/release-check.mjs",
    "cloud:init": "tsx server/cloud-main.ts init",
    "cloud:reset": "tsx server/cloud-main.ts reset",
    "cloud:start": "tsx server/cloud-main.ts start",
    "worker:pair": "tsx server/worker-pair.ts",
    "worker:start": "tsx server/main.ts --worker"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
